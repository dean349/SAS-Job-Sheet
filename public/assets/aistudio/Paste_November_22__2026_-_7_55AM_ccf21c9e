        view === 'table'
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white';

      document.getElementById('cards-container').classList.toggle('hidden', view !== 'cards');
      document.getElementById('table-container').classList.toggle('hidden', view !== 'table');
    }

    function renderFilterPills() {
      const container = document.getElementById('filter-pills');
      container.innerHTML = FILTERS.map(f => {
        const isActive = activeFilter === f.id;
        return `
          <button
            onclick="setFilter('${f.id}')"
            class="shrink-0 px-3 py-1.5 rounded-full text-xs font-bold transition border ${
              isActive
                ? 'bg-cyan-500 text-slate-950 border-cyan-400 shadow'
                : 'bg-slate-800/90 text-slate-300 border-slate-700 hover:border-slate-500'
            }"
          >
            ${f.label}
          </button>
        `;
      }).join('');
    }

    function setFilter(filterId) {
      activeFilter = filterId;
      renderFilterPills();
      renderManifest();
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      renderManifest();
    }

    function toggleConfirmed(id, e) {
      if (e) e.stopPropagation();
      confirmedMap[id] = !confirmedMap[id];
      saveState();
      renderManifest();
    }

    function togglePaid(id, e) {
      if (e) e.stopPropagation();
      paidMap[id] = !paidMap[id];
      saveState();
      renderManifest();
    }

    function updateFlightNote(id, value) {
      flightNotesMap[id] = value;
      saveState();
    }

    function updateStats() {
      let confirmedCount = 0;
      let cashCollected = 0;
      MANIFEST_DATA.forEach(item => {
        if (confirmedMap[item.id]) confirmedCount++;
        if (paidMap[item.id]) cashCollected += item.pax * item.rate;
      });
      document.getElementById('stat-confirmed').textContent = `${confirmedCount} / 33`;
      document.getElementById('stat-cash').innerHTML = `$${cashCollected.toLocaleString()} <span class="text-[11px] font-normal text-slate-400">/ $1,860</span>`;
    }

    function getTerminalBadgeColor(terminal) {
      switch (terminal) {
        case 'V': return 'bg-rose-500/20 text-rose-300 border-rose-500/40';
        case 'F': return 'bg-sky-500/20 text-sky-300 border-sky-500/40';
        case 'D': return 'bg-amber-500/20 text-amber-300 border-amber-500/40';
        case 'A': return 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40';
        case 'AA': return 'bg-purple-500/20 text-purple-300 border-purple-500/40';
        default: return 'bg-cyan-500/20 text-cyan-300 border-cyan-500/40';
      }
    }

    function getFilteredData() {
      const query = document.getElementById('search-input').value.trim().toLowerCase();
      document.getElementById('clear-search').classList.toggle('hidden', query.length === 0);

      return MANIFEST_DATA.filter(item => {
        if (activeFilter === 'HOTELS' && item.dropoff === 'Fort Lauderdale Airport (FLL)') return false;
        if (activeFilter === 'HANDWRITTEN' && item.type !== 'Handwritten') return false;
        if (activeFilter === 'CONFIRMED' && !confirmedMap[item.id]) return false;
        if (['V', 'F', 'D', 'A', 'AA'].includes(activeFilter) && item.terminal !== activeFilter) return false;

        if (!query) return true;
        const searchable = `${item.name} ${item.phoneDisplay} ${item.ship} ${item.terminal} ${item.dropoff} ${item.note} ${flightNotesMap[item.id] || ''}`.toLowerCase();
        return searchable.includes(query);
      });
    }

    function renderManifest() {
      const items = getFilteredData();
      const cardsContainer = document.getElementById('cards-container');
      const tableBody = document.getElementById('table-body');

      if (items.length === 0) {
        cardsContainer.innerHTML = `
          <div class="col-span-full bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center text-slate-400 text-sm">
            No matching passengers found. Try clearing your search or switching filters.
          </div>
        `;
        tableBody.innerHTML = `
          <tr>
            <td colspan="9" class="py-8 text-center text-slate-400 text-sm">No matching passengers found.</td>
          </tr>
        `;
        return;
      }

      // Render Mobile-First Cards
      cardsContainer.innerHTML = items.map(item => {
        const isConfirmed = !!confirmedMap[item.id];
        const isPaid = !!paidMap[item.id];
