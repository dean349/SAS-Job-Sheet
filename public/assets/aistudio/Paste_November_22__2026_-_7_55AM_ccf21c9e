                    : ''
                }
              </div>
              <div class="text-right shrink-0">
                <span class="text-sm font-extrabold text-emerald-400">$${cashTotal}</span>
                <span class="text-[11px] text-slate-400 ml-1">(${item.pax} @ $${item.rate})</span>
              </div>
            </div>

            <!-- Middle Row: Passenger Name + Big Tap-to-Call/Text Button -->
            <div class="flex items-center justify-between gap-2 mt-2.5">
              <div>
                <h3 class="text-lg font-extrabold text-white leading-tight">${item.name}</h3>
                <div class="flex items-center gap-1.5 mt-1">
                  <span class="text-[11px] font-semibold text-slate-400">PortMiami &rarr;</span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded-md ${
                    isHotel
                      ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                      : 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30'
                  }">
                    ${item.dropoff}
                  </span>
                </div>
              </div>

              <!-- TAP PHONE NUMBER BUTTON -->
              <button
