    <!-- Quick Destination & Terminal Summary Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-4">
      <div class="bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-2.5 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-cyan-400 uppercase">FLL Airport Drop-Off</span>
          <p class="text-xs text-slate-400">31 bookings &bull; All rows without hotel</p>
        </div>
        <div class="text-right">
          <div class="text-sm font-extrabold text-white">89 Pax</div>
          <div class="text-xs font-bold text-emerald-400">$1,780</div>
        </div>
      </div>

      <div class="bg-slate-900 border border-amber-500/30 rounded-xl px-3.5 py-2.5 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-amber-300 uppercase">Fairfield Hotel</span>
          <p class="text-xs text-slate-400">Nancy &bull; Celebration (Term F)</p>
        </div>
        <div class="text-right">
          <div class="text-sm font-extrabold text-white">2 Pax</div>
          <div class="text-xs font-bold text-emerald-400">$40</div>
        </div>
      </div>

      <div class="bg-slate-900 border border-amber-500/30 rounded-xl px-3.5 py-2.5 flex items-center justify-between">
