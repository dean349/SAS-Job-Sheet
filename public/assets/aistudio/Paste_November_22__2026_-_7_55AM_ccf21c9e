                  : 'bg-cyan-500/15 text-cyan-300'
              }">
                ${item.dropoff}
              </span>
            </td>
            <td class="py-2.5 px-2.5 text-center text-xs font-extrabold text-white">${item.pax}</td>
            <td class="py-2.5 px-3 text-right text-xs font-extrabold text-emerald-400">$${cashTotal}</td>
            <td class="py-2.5 px-3 text-center whitespace-nowrap">
              <div class="inline-flex items-center gap-1">
                <button
                  onclick="toggleConfirmed(${item.id}, event)"
                  class="px-2 py-1 rounded text-[11px] font-bold ${
                    isConfirmed ? 'bg-amber-400 text-slate-950' : 'bg-slate-800 text-slate-300'
                  }"
