            <td class="py-2.5 px-3 text-xs font-bold text-white whitespace-nowrap">
              ${item.ship}
              ${item.type === 'Handwritten' ? '<span class="ml-1 text-[10px] px-1.5 py-0.2 rounded bg-fuchsia-500/20 text-fuchsia-300">HW</span>' : ''}
