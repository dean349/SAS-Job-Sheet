                <button
                  onclick="togglePaid(${item.id}, event)"
                  class="px-2 py-1 rounded text-[11px] font-bold ${
                    isPaid ? 'bg-emerald-500 text-slate-950' : 'bg-slate-800 text-slate-300'
                  }"
                >
                  ${isPaid ? 'Paid' : '$'}
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function buildSmsMessage(item) {
      const destText =
        item.dropoff === 'Fort Lauderdale Airport (FLL)'
          ? 'FLL Airport'
          : item.dropoff;

      let terminalHint = '';
      if (item.terminal === 'D') {
        terminalHint = ' Note: For Terminal D, walk across the crosswalk to the front of Garage D where commercial shuttles load.';
      } else if (item.terminal === 'A') {
        terminalHint = ' Note: For Terminal A, walk out to the middle Ground Transportation island at Zone 7.';
      }

      return `Good morning ${item.name}! This is Dean with ${brandName} staged here at PortMiami for your ${item.ship} transfer to ${destText}. Please reply with your airline/flight # and call or text me as soon as you clear Customs with all bags in hand.${terminalHint}`;
    }

    function populateModalLinks(item, customRawPhone = null, customDisplayPhone = null) {
      const rawPhone = customRawPhone !== null ? customRawPhone : item.phoneRaw;
      const displayPhone = customDisplayPhone !== null ? customDisplayPhone : item.phoneDisplay;
      const smsBody = buildSmsMessage(item);

      document.getElementById('modal-phone-display').textContent = displayPhone;
      document.getElementById('modal-sms-preview').textContent = smsBody;

      const btnCall = document.getElementById('btn-call');
      const btnSmsPrefilled = document.getElementById('btn-sms-prefilled');
      const btnSmsBlank = document.getElementById('btn-sms-blank');

      if (!rawPhone) {
        btnCall.removeAttribute('href');
        btnSmsPrefilled.removeAttribute('href');
        btnSmsBlank.removeAttribute('href');
        btnCall.classList.add('opacity-40', 'pointer-events-none');
        btnSmsPrefilled.classList.add('opacity-40', 'pointer-events-none');
        btnSmsBlank.classList.add('opacity-40', 'pointer-events-none');
      } else {
        // Pure native tel: and cross-platform iOS/Android sms: links
        btnCall.href = `tel:${rawPhone}`;
        btnSmsPrefilled.href = `sms:${rawPhone}?&body=${encodeURIComponent(smsBody)}`;
        btnSmsBlank.href = `sms:${rawPhone}`;
        btnCall.classList.remove('opacity-40', 'pointer-events-none');
        btnSmsPrefilled.classList.remove('opacity-40', 'pointer-events-none');
        btnSmsBlank.classList.remove('opacity-40', 'pointer-events-none');
      }
    }

    function openActionModal(id) {
      const item = MANIFEST_DATA.find(p => p.id === id);
      if (!item) return;
      activePassenger = item;

      const badge = document.getElementById('modal-terminal-badge');
      badge.textContent = `TERM ${item.terminal} · ${item.access.toUpperCase()}`;
      badge.className = `px-2 py-0.5 rounded-md text-xs font-extrabold border ${getTerminalBadgeColor(item.terminal)}`;

      document.getElementById('modal-ship').textContent = `${item.ship} (${item.line})`;
      document.getElementById('modal-name').textContent = item.name;
      document.getElementById('modal-details').textContent = `${item.pax} Pax · $${item.pax * item.rate} Cash Due · ${item.dropoff}`;

      const missingBox = document.getElementById('missing-digit-box');
      const missingInput = document.getElementById('missing-digit-input');
      if (item.incomplete) {
        missingBox.classList.remove('hidden');
        missingInput.value = '';
      } else {
        missingBox.classList.add('hidden');
      }

      populateModalLinks(item);
      document.getElementById('action-modal').classList.remove('hidden');
    }

    function updateMissingDigit(digit) {
      if (!activePassenger) return;
      const cleanDigit = digit.replace(/\D/g, '').slice(0, 1);
      if (cleanDigit) {
        const fullDisplay = `${cleanDigit}79-721-2090`;
        const fullRaw = `+1${cleanDigit}797212090`;
        populateModalLinks(activePassenger, fullRaw, fullDisplay);
      } else {
        populateModalLinks(activePassenger, '', '_79-721-2090');
      }
    }

    function closeModal() {
      document.getElementById('action-modal').classList.add('hidden');
      activePassenger = null;
    }

    function closeModalOnBackdrop(e) {
      if (e.target.id === 'action-modal') {
        closeModal();
      }
    }

    function copyTextToClipboard(text, message) {
      try {
        const tempInput = document.createElement('textarea');
        tempInput.value = text;
        tempInput.setAttribute('readonly', '');
        tempInput.style.position = 'fixed';
        tempInput.style.opacity = '0';
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        showToast(message);
      } catch (e) {
        showToast('Press and hold to copy');
      }
    }

    function copyPhoneNumber() {
      const phoneText = document.getElementById('modal-phone-display').textContent.trim();
      copyTextToClipboard(phoneText, `Copied ${phoneText}`);
    }

    function copySmsText() {
      const smsText = document.getElementById('modal-sms-preview').textContent.trim();
      copyTextToClipboard(smsText, 'Copied SMS template');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2200);
    }

    // Initialize app on load
    window.addEventListener('DOMContentLoaded', () => {
      setBrand(brandName);
      renderFilterPills();
      updateStats();
      renderManifest();
    });
  </script>
</body>
</html>