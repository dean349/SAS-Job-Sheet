    // Safe localStorage helpers (prevents crashes in restricted mobile WebViews)
    function safeGetStorage(key, fallback) {
      try {
        const val = localStorage.getItem(key);
        return val !== null ? val : fallback;
      } catch (e) {
        return fallback;
      }
    }

    function safeGetJSON(key, fallback) {
      try {
        const val = localStorage.getItem(key);
        return val ? JSON.parse(val) : fallback;
      } catch (e) {
        return fallback;
      }
    }

    function safeSetStorage(key, value) {
      try {
        localStorage.setItem(key, value);
      } catch (e) {
        // Ignore storage errors in private/sandboxed views
      }
    }

    // App State
    let activeFilter = 'ALL';
    let currentView = 'cards';
    let brandName = safeGetStorage('dean_brand', 'SAS');
    let confirmedMap = safeGetJSON('dean_confirmed_1122', {});
    let paidMap = safeGetJSON('dean_paid_1122', {});
    let flightNotesMap = safeGetJSON('dean_notes_1122', {});
    let activePassenger = null;

    const FILTERS = [
      { id: 'ALL', label: 'All (33)' },
      { id: 'V', label: 'V · Virgin (9)' },
      { id: 'F', label: 'F · Celebration (12)' },
      { id: 'D', label: 'D · Magic (4)' },
      { id: 'A', label: 'A · Allure (5)' },
      { id: 'AA', label: 'AA · MSC/Indep (3)' },
      { id: 'HOTELS', label: 'Hotels Only (2)' },
      { id: 'HANDWRITTEN', label: 'Handwritten (5)' },
      { id: 'CONFIRMED', label: 'Yellow Confirmed' }
    ];

    function saveState() {
      safeSetStorage('dean_brand', brandName);
      safeSetStorage('dean_confirmed_1122', JSON.stringify(confirmedMap));
      safeSetStorage('dean_paid_1122', JSON.stringify(paidMap));
      safeSetStorage('dean_notes_1122', JSON.stringify(flightNotesMap));
      updateStats();
    }

    function setBrand(brand) {
      brandName = brand;
      document.getElementById('brand-sas').className =
        brand === 'SAS'
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-cyan-600 text-white shadow'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white';
      document.getElementById('brand-alv').className =
        brand === 'A Luxury Vans'
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-cyan-600 text-white shadow'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white';
      saveState();
      if (activePassenger) {
        populateModalLinks(activePassenger);
      }
    }

    function setView(view) {
      currentView = view;
      document.getElementById('view-cards').className =
        view === 'cards'
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white';
