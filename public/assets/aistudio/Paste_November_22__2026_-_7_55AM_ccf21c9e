<body class="bg-slate-950 text-slate-100 min-h-screen pb-24">

  <!-- Sticky Top Command Header -->
  <header class="sticky top-0 z-30 bg-slate-900/95 backdrop-blur border-b border-slate-800 shadow-lg">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
              11-22 SHIFT
            </span>
            <h1 class="text-base sm:text-xl font-extrabold tracking-tight text-white">
              PortMiami &rarr; FLL / Hotels
            </h1>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Tap any phone number to <span class="text-emerald-400 font-semibold">Call</span> or <span class="text-sky-400 font-semibold">Text</span> on iPhone
          </p>
        </div>

        <!-- Brand Toggle for Pre-filled SMS Scripts -->
        <div class="flex items-center gap-1 bg-slate-800 p-1 rounded-xl border border-slate-700">
          <button
            id="brand-sas"
            onclick="setBrand('SAS')"
            class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-cyan-600 text-white shadow"
          >
            SAS
          </button>
          <button
            id="brand-alv"
            onclick="setBrand('A Luxury Vans')"
            class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white"
          >
            A Luxury Vans
          </button>
        </div>
      </div>

      <!-- Live Shift Metrics Strip -->
      <div class="grid grid-cols-4 gap-2 mt-3">
        <div class="bg-slate-800/80 border border-slate-700/70 rounded-xl px-2.5 py-1.5">
          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Bookings</div>
          <div class="text-sm sm:text-base font-extrabold text-white">33 <span class="text-[11px] font-normal text-slate-400">(5 HW)</span></div>
        </div>
        <div class="bg-slate-800/80 border border-slate-700/70 rounded-xl px-2.5 py-1.5">
          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Total Pax</div>
          <div class="text-sm sm:text-base font-extrabold text-cyan-300">93</div>
        </div>
        <div class="bg-slate-800/80 border border-slate-700/70 rounded-xl px-2.5 py-1.5">
          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Confirmed</div>
          <div id="stat-confirmed" class="text-sm sm:text-base font-extrabold text-amber-300">0 / 33</div>
        </div>
        <div class="bg-slate-800/80 border border-slate-700/70 rounded-xl px-2.5 py-1.5">
          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Cash Paid</div>
          <div id="stat-cash" class="text-sm sm:text-base font-extrabold text-emerald-400">$0 <span class="text-[11px] font-normal text-slate-400">/ $1,860</span></div>
        </div>
      </div>

      <!-- Search + View Mode Switcher -->
      <div class="flex items-center gap-2 mt-3">
        <div class="relative flex-1">
          <input
            id="search-input"
            type="text"
            placeholder="Search name, phone, ship, hotel..."
            oninput="renderManifest()"
            class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-3.5 pr-8 py-2 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500"
          />
          <button
            id="clear-search"
            onclick="clearSearch()"
            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs font-bold px-1.5 py-0.5 rounded bg-slate-700"
          >
            ✕
          </button>
        </div>

        <div class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700 shrink-0">
          <button
            id="view-cards"
            onclick="setView('cards')"
            class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-slate-700 text-white"
          >
            Cards
          </button>
          <button
            id="view-table"
            onclick="setView('table')"
            class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white"
          >
            Landscape
          </button>
        </div>
      </div>

      <!-- Terminal & Category Filter Pills -->
      <div id="filter-pills" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar mt-2.5 pb-0.5">
        <!-- Populated dynamically -->
      </div>
    </div>
  </header>

