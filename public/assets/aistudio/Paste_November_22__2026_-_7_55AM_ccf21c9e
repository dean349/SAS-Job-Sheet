                  item.incomplete
                    ? 'bg-amber-600/30 text-amber-200 border border-amber-500/50'
                    : 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-emerald-950/50'
                }"
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <span>${item.phoneDisplay}</span>
              </button>
            </div>

            <!-- Airline / Flight Quick Note Input -->
            <div class="mt-2.5">
              <input
                type="text"
                value="${savedFlight.replace(/"/g, '&quot;')}"
                placeholder="Airline / Flight # or pickup note..."
                oninput="updateFlightNote(${item.id}, this.value)"
                class="w-full bg-slate-950/70 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500"
              />
            </div>

            <!-- Bottom Action Toggles: Highlight Yellow & Cash Paid -->
            <div class="grid grid-cols-2 gap-2 mt-2.5 pt-2 border-t border-slate-800/80">
              <button
                onclick="toggleConfirmed(${item.id}, event)"
                class="py-1.5 px-2.5 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 border ${
                  isConfirmed
                    ? 'bg-amber-400 text-slate-950 border-amber-300'
                    : 'bg-slate-800 text-slate-300 border-slate-700 hover:border-amber-400/50'
                }"
              >
                <span>${isConfirmed ? '★ Highlighted' : '☆ Highlight Yellow'}</span>
              </button>

              <button
                onclick="togglePaid(${item.id}, event)"
                class="py-1.5 px-2.5 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 border ${
                  isPaid
                    ? 'bg-emerald-500 text-slate-950 border-emerald-400'
                    : 'bg-slate-800 text-slate-300 border-slate-700 hover:border-emerald-400/50'
                }"
              >
                <span>${isPaid ? '✓ Cash Paid ($' + cashTotal + ')' : '$ Mark Cash Paid'}</span>
              </button>
            </div>
          </div>
        `;
      }).join('');

      // Render Landscape Table Rows
      tableBody.innerHTML = items.map(item => {
        const isConfirmed = !!confirmedMap[item.id];
        const isPaid = !!paidMap[item.id];
        const cashTotal = item.pax * item.rate;
        const isHotel = item.dropoff !== 'Fort Lauderdale Airport (FLL)';

        return `
          <tr class="${isConfirmed ? 'bg-amber-950/35' : 'hover:bg-slate-800/50'} transition">
            <td class="py-2.5 px-3 text-xs font-semibold text-slate-300 whitespace-nowrap">${item.pickup}</td>
            <td class="py-2.5 px-2.5 whitespace-nowrap">
